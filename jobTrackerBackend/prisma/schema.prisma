datasource db {
	provider = "sqlite"
	url      = "file:./dev.db"
}

generator client {
	provider = "prisma-client-js"
}

model User {
	id        String  @id @default(cuid())
	name      String
	email     String  @unique
	password  String
	jobs      Job[]
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model Job {
	id        String   @id @default(cuid())
	company   String
	role      String
	location  String?
	salary    String?
	status    String   @default("Applied")
	notes     String?
	userId    String
	user      User     @relation(fields: [userId], references: [id])
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}
